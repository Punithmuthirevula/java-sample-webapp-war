pipeline {
    agent any

    environment {
        APP_NAME = "sample-multibranch-app"
        DEPLOY_DIR = "/opt/tomcat11/webapps"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Branch: ${env.BRANCH_NAME}"
                echo "Commit: ${env.GIT_COMMIT}"
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Deploy (only main branch)') {
            when {
                branch 'main'
            }
            steps {
                echo "Deploying from MAIN branch only"
                sh '''
                  echo "Deploy logic here"
                  # scp target/my-app.war ec2-user@<EC2-IP>:/opt/tomcat11/webapps
                  # ssh ec2-user@<EC2-IP> "cd /opt/tomcat11/bin && ./shutdown.sh && ./startup.sh"
                '''
            }
        }

        stage('Dev branch special step') {
            when {
                branch 'dev'
            }
            steps {
                echo "This runs only on dev branch"
            }
        }
    }

    post {
        success {
            echo "Build success on ${env.BRANCH_NAME}"
        }
        failure {
            echo "Build failed on ${env.BRANCH_NAME}"
        }
    }
}
