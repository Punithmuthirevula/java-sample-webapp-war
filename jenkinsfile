pipeline {
    agent any
      stages {
        stage ("Build"){
            when {
                branch "develop"
                }
            steps {
                echo "Build happens here"
            }

        }
        stage ("test"){
                when {
                                branch "develop"
                                }
                    steps {
                        echo "Teat Dev happens here"
                    }
        
                }
        stage ("Deploy"){
                when {
                                branch "main"
                                }
                            steps {
                                echo "Deploy Prod happens here"
                            }
                
                }
      }
}
